#!/bin/sh
# Blocks a push if the CV data or the built site is broken. Enable once per clone with:
#   git config core.hooksPath .githooks
# Bypass in an emergency with: git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: checking the CV site..."
python3 tools/check_site.py || { echo "pre-push: push blocked, fix the errors above." >&2; exit 1; }
